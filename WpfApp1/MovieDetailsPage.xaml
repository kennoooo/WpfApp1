<Page x:Class="WpfApp1.MovieDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Фильм" Height="450" Width="800">
    <StackPanel>
        <Button Content="Назад" Click="Back_Click"/>
        <TextBlock Name="TxtTitle" FontSize="24" FontWeight="Bold"/>
        <TextBlock Name="TxtDesc" TextWrapping="Wrap"/>
        <TextBlock Name="TxtRating"/>

        <Label Content="Сеансы:" FontWeight="Bold" Margin="0,20,0,0"/>
        <ListView Name="SessionsList" MouseDoubleClick="SessionsList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding DateTime}"/>
                    <GridViewColumn Header="Зал" DisplayMemberBinding="{Binding Halls.Name}"/>
                    <GridViewColumn Header="Тип зала" DisplayMemberBinding="{Binding Halls.Category}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Page>