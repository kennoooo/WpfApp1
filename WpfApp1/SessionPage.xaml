<Page x:Class="WpfApp1.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выбор места" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ЭКРАН" HorizontalAlignment="Center" Background="Gray" Width="300" TextAlignment="Center"/>

        <UniformGrid Name="SeatsContainer" Grid.Row="1" Rows="5" Columns="10" Margin="20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Name="TxtSelectedPlace" VerticalAlignment="Center" Margin="10"/>
            <Button Content="Очистить" Click="BtnClear_Click" Margin="5"/>
            <Button Content="Купить билет" Click="BtnBuy_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>