<Page x:Class="WpfApp1.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" Height="450" Width="800">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300">
            <TextBlock Text="Создание аккаунта" FontSize="24" HorizontalAlignment="Center"/>

            <TextBlock Text="Имя пользователя"/>
            <TextBox x:Name="TxtName" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Логин (Email)"/>
            <TextBox x:Name="TxtLogin" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Пароль"/>
            <TextBox x:Name="TxtPass" Margin="0,5,0,20" Padding="5"/>

            <Button Content="Зарегистрироваться" Click="BtnReg_Click" Height="35" Margin="0,0,0,10" Background="LightGreen"/>
            
            <Button Content="Уже есть аккаунт? Войти" Click="BtnBack_Click" Background="Transparent" BorderBrush="Transparent" Foreground="Blue" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>